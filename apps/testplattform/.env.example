# ==========================================================
# Ziegler Treuhand Testplattform - Environment Variables
# ==========================================================
# Kopiere diese Datei zu ".env.local" und traege deine Werte ein.
# .env.local wird von .gitignore ausgeschlossen und bleibt lokal.
# ==========================================================

# --- Anthropic / Claude API ----------------------------------
# Einen Key erstellen unter: https://console.anthropic.com/settings/keys
# Kosten: ~0,003 USD pro Beschluss-Extraktion (Sonnet 4.6)
ANTHROPIC_API_KEY=sk-ant-api03-HIER-DEINEN-KEY-EINFUEGEN

# Standard-Modell fuer Extraktionen (Beschluss, Artikelliste)
# claude-sonnet-4-6  = gutes Preis-/Leistungsverhaeltnis
# claude-opus-4-7    = hoechste Qualitaet, teurer
ANTHROPIC_MODEL=claude-sonnet-4-6


# --- DB-Pfad (optional, Default ist ./data/app.db) ----------
# DB_PATH=./data/app.db
